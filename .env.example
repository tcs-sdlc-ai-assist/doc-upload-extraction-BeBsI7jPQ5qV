# Document Upload & Extraction - Environment Variables
# Copy this file to .env and fill in the values

# Encryption key used for securing localStorage data (credentials, session, documents)
# Generate a strong random string for production use
# Example: openssl rand -base64 32
VITE_ENCRYPTION_KEY=your-secret-encryption-key-change-in-production

# Note: All VITE_ prefixed variables are exposed to the client-side bundle.
# Do NOT store truly sensitive secrets here in a production application.
# This encryption is for demo/educational purposes only — localStorage
# is not a secure storage mechanism for sensitive data.